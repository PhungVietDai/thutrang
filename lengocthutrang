<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Love ❤️</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    min-height: 100vh;
    overflow: hidden;
    color: #6f3147;

    background:
        radial-gradient(circle at 8% 12%, rgba(255, 82, 150, .55), transparent 26%),
        radial-gradient(circle at 92% 15%, rgba(255, 125, 185, .42), transparent 28%),
        radial-gradient(circle at 12% 88%, rgba(255, 35, 115, .38), transparent 30%),
        radial-gradient(circle at 88% 90%, rgba(255, 80, 155, .42), transparent 32%),
        linear-gradient(135deg, #2a0315 0%, #680d37 38%, #a91d5b 68%, #3b061e 100%);
}

.heart-layer {
    position: fixed;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 2;
}

.heart-fly {
    position: absolute;
    bottom: -70px;
    left: 0;

    color: #ff8fba;
    font-size: 24px;
    line-height: 1;

    opacity: 0;

    text-shadow:
        0 0 7px rgba(255, 80, 145, .95),
        0 0 18px rgba(255, 55, 130, .75),
        0 0 35px rgba(255, 100, 170, .45);

    animation: heartRise linear forwards;
}

@keyframes heartRise {
    0% {
        transform: translate3d(0, 0, 0) rotate(-12deg) scale(.65);
        opacity: 0;
    }

    10% {
        opacity: .95;
    }

    45% {
        transform: translate3d(var(--drift1), -48vh, 0)
                   rotate(var(--rot1)) scale(1);
        opacity: .85;
    }

    75% {
        transform: translate3d(var(--drift2), -82vh, 0)
                   rotate(var(--rot2)) scale(1.15);
        opacity: .6;
    }

    100% {
        transform: translate3d(var(--drift3), -120vh, 0)
                   rotate(var(--rot3)) scale(1.35);
        opacity: 0;
    }
}

/* Tim nhỏ lấp lánh ở hai bên */
.heart-sparkles {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 6;
}

.heart-spark {
    position: absolute;

    color: #ffd0df;
    font-size: 14px;

    opacity: 0;

    text-shadow:
        0 0 7px #ff72aa,
        0 0 18px #ff3f8b;

    animation: sparkle 2.4s ease-in-out infinite;
}

@keyframes sparkle {
    0%, 100% {
        opacity: 0;
        transform: scale(.4) rotate(0);
    }

    45% {
        opacity: 1;
        transform: scale(1.35) rotate(15deg);
    }

    70% {
        opacity: .35;
        transform: scale(.75) rotate(-12deg);
    }
}

/* =========================
   MÀN HÌNH MẬT KHẨU
========================= */

#loginScreen {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 25px;
    position: relative;
    z-index: 10;
}

/* Khung chính */

.login-box {
    width: min(950px, 100%);
    min-height: 560px;

    display: grid;
    grid-template-columns: 1fr 1fr;

    background: linear-gradient(
        135deg,
        rgba(255, 110, 165, .18),
        rgba(255, 255, 255, .08)
    );
    border: 1px solid rgba(255, 166, 205, .38);
    border-radius: 30px;

    overflow: hidden;

    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);

    box-shadow:
        0 30px 90px rgba(20, 0, 12, .55),
        0 0 80px rgba(255, 45, 125, .28),
        0 0 25px rgba(255, 120, 175, .18);
}

/* =========================
   ẢNH BÊN TRÁI
========================= */

.photo-side {
    position: relative;
    min-height: 560px;
    overflow: hidden;
}

.photo-side img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;

    transition: transform 1s ease;
}

.photo-side:hover img {
    transform: scale(1.05);
}

/* lớp phủ ảnh */

.photo-overlay {
    position: absolute;
    inset: 0;

    background:
        linear-gradient(
            to top,
            rgba(20,0,10,.85),
            rgba(20,0,10,.05) 65%
        );
}

/* chữ trên ảnh */

.photo-text {
    position: absolute;
    left: 35px;
    bottom: 35px;
    right: 35px;
}

.photo-text .small {
    font-size: 14px;
    color: #ffb6ca;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 10px;
}

.photo-text h2 {
    font-size: 36px;
    line-height: 1.1;
    margin-bottom: 10px;
}

.photo-text p {
    color: #f5dce4;
    font-size: 15px;
}

/* =========================
   PHẦN NHẬP MẬT KHẨU
========================= */

.password-side {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    padding: 50px;
    text-align: center;
}

.heart {
    width: 75px;
    height: 75px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: rgba(255,70,120,.12);
    border: 1px solid rgba(255,120,160,.25);

    font-size: 38px;

    margin-bottom: 25px;

    animation: heartbeat 1.8s infinite;
}

@keyframes heartbeat {
    0%, 100% {
        transform: scale(1);
    }

    15% {
        transform: scale(1.08);
    }

    30% {
        transform: scale(1);
    }

    45% {
        transform: scale(1.05);
    }
}

.password-side h1 {
    font-size: 32px;
    margin-bottom: 10px;
}

.subtitle {
    color: #dcbec8;
    font-size: 14px;
    margin-bottom: 30px;
    line-height: 1.6;
}

/* HIỂN THỊ MẬT KHẨU */
.password-display {
    width: 280px;
    max-width: 100%;
    height: 52px;

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 13px;

    margin-bottom: 15px;

    border-radius: 15px;

    background: rgba(0,0,0,.22);
    border: 1px solid rgba(255,255,255,.13);

    transition: .2s;
}

.password-display.active {
    border-color: rgba(255,70,125,.45);
    box-shadow: 0 0 20px rgba(255,50,110,.08);
}

.dot {
    width: 10px;
    height: 10px;
    display: block;

    border-radius: 50%;

    background: #ff477e;

    box-shadow: 0 0 10px rgba(255,71,126,.65);

    animation: dotAppear .15s ease;
}

@keyframes dotAppear {
    from {
        transform: scale(0);
        opacity: 0;
    }
    to {
        transform: scale(1);
        opacity: 1;
    }
}

/* BÀN PHÍM SỐ */
.keypad {
    width: 280px;
    max-width: 100%;

    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
}

.key {
    height: 51px;

    border-radius: 14px;
    border: 1px solid rgba(255,255,255,.11);
    outline: none;

    background: rgba(255,255,255,.055);
    color: #6f3147;

    font-size: 17px;
    font-weight: 600;

    cursor: pointer;

    transition:
        transform .12s ease,
        background .12s ease,
        border-color .12s ease,
        box-shadow .12s ease;
}

.key:hover {
    background: rgba(255,70,125,.15);
    border-color: rgba(255,90,140,.35);
    box-shadow: 0 5px 20px rgba(255,50,110,.10);
    transform: translateY(-2px);
}

.key:active {
    transform: scale(.93);
    background: rgba(255,70,125,.28);
}

.key.delete {
    color: #ff8daa;
    font-size: 18px;
}

.key.zero {
    grid-column: 2;
}

.error {
    min-height: 20px;
    margin-top: 10px;

    color: #ff789f;
    font-size: 12px;
    text-align: center;
}

/* =========================
   PHẦN SAU KHI ĐĂNG NHẬP
========================= */

        /* =========================================
           LÁ THƯ GỬI TẶNG EM
        ========================================= */

        #lovePage {
            display: none;
            width: 100%;
            height: 100vh;
            align-items: center;
            justify-content: center;
            padding: 25px;
            position: relative;
            z-index: 5;
        }

        .letter-scene {
            position: relative;
            width: min(900px, 94vw);
            height: min(720px, 90vh);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .closed-letter {
            position: relative;
            width: min(480px, 88vw);
            cursor: pointer;
            text-align: center;
            transition: .35s ease;
        }

        .closed-letter:hover {
            transform: translateY(-9px) rotate(-1deg);
            filter: drop-shadow(0 25px 35px rgba(255,70,140,.35));
        }

        .envelope {
            position: relative;
            width: 100%;
            aspect-ratio: 1.55;
            overflow: hidden;
            border-radius: 12px;
            background: #6f3147;
            box-shadow:
                0 30px 80px rgba(35,0,20,.45),
                0 0 55px rgba(255,90,155,.30);
        }

        .envelope-back {
            position: absolute;
            inset: 0;
            background: linear-gradient(145deg,#fff,#fff6fa 55%,#ffe1ed);
        }

        .envelope-paper {
            position: absolute;
            left: 12%;
            top: 8%;
            width: 76%;
            height: 87%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 2;
            border-radius: 6px;
            background: #6f3147;
            box-shadow: 0 5px 18px rgba(90,15,45,.12);
        }

        .letter-title {
            color: #c92b62;
            font-family: Georgia,"Times New Roman",serif;
            font-size: clamp(28px,5vw,45px);
            font-style: italic;
            font-weight: 700;
        }

        .letter-line {
            width: 115px;
            height: 2px;
            margin-top: 12px;
            background: linear-gradient(90deg,transparent,#e65b8b,transparent);
        }

        .envelope-flap {
            position: absolute;
            top: 0;
            left: 0;
            width: 0;
            height: 0;
            border-left: 240px solid transparent;
            border-right: 240px solid transparent;
            border-top: 180px solid #6f3147;
            z-index: 5;
            filter: drop-shadow(0 2px 2px rgba(120,20,60,.10));
        }

        .envelope-front {
            position: absolute;
            left: 0;
            bottom: 0;
            width: 100%;
            height: 55%;
            z-index: 6;
            background: linear-gradient(145deg,#fffaff,#ffe5f0);
            clip-path: polygon(0 0,50% 100%,100% 0);
        }

        .wax-heart {
            position: absolute;
            left: 50%;
            top: 52%;
            width: 70px;
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: center;
            transform: translate(-50%,-50%);
            z-index: 8;
            border-radius: 50%;
            border: 4px solid #6f3147;
            background: linear-gradient(145deg,#ff5c8d,#d91e59);
            box-shadow: 0 8px 28px rgba(180,20,75,.30);
            font-size: 31px;
            transition: .3s ease;
        }

        .closed-letter:hover .wax-heart {
            transform: translate(-50%,-50%) scale(1.1);
        }

        .click-hint {
            margin-top: 25px;
            color: #b85d79;
            font-size: 14px;
            animation: hintPulse 1.8s ease-in-out infinite;
        }

        @keyframes hintPulse {
            0%,100% { opacity: .55; }
            50% { opacity: 1; }
        }

        .opened-letter {
            display: none;
            position: absolute;
            width: min(700px,92vw);
            max-height: 88vh;
            animation: letterOpen .65s cubic-bezier(.2,.8,.2,1);
        }

        @keyframes letterOpen {
            from {
                opacity: 0;
                transform: translateY(35px) scale(.88) rotate(-2deg);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1) rotate(0);
            }
        }

        .paper {
            position: relative;
            width: 100%;
            max-height: 86vh;
            overflow-y: auto;
            padding: 48px clamp(25px,6vw,65px);
            border-radius: 9px;
            background: linear-gradient(135deg,#fff,#fff8fb);
            color: #60283f;
            box-shadow:
                0 35px 90px rgba(30,0,20,.45),
                0 0 55px rgba(255,100,165,.28);
            border: 1px solid rgba(255,255,255,.9);
        }

        .paper::before {
            content: "";
            position: absolute;
            inset: 12px;
            border: 1px solid rgba(210,60,115,.16);
            border-radius: 6px;
            pointer-events: none;
        }

        .close-letter {
            position: absolute;
            top: 18px;
            right: 20px;
            width: 34px;
            height: 34px;
            border: 0;
            border-radius: 50%;
            background: #ffe2ed;
            color: #c42b62;
            font-size: 22px;
            cursor: pointer;
            z-index: 5;
            transition: .2s;
        }

        .close-letter:hover {
            background: #ffc5da;
            transform: rotate(90deg);
        }

        .paper-top-heart {
            text-align: center;
            font-size: 34px;
            margin-bottom: 8px;
        }

        .paper-small {
            color: #d25a84;
            text-align: center;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 4px;
        }

        .paper h1 {
            margin: 10px 0 8px;
            color: #c72861;
            text-align: center;
            font-family: Georgia,"Times New Roman",serif;
            font-size: clamp(34px,6vw,50px);
            font-style: italic;
        }

        .paper-line {
            width: 150px;
            height: 2px;
            margin: 0 auto 25px;
            background: linear-gradient(90deg,transparent,#e35b8a,transparent);
        }

        .letter-content {
            position: relative;
            z-index: 1;
        }

        .letter-content p {
            margin-bottom: 17px;
            color: #633044;
            font-family: Georgia,"Times New Roman",serif;
            font-size: 17px;
            line-height: 1.8;
        }

        .letter-content .special {
            color: #c52861;
            text-align: center;
            font-weight: 700;
            margin-top: 25px;
        }

        .signature {
            margin-top: 28px;
            padding-top: 18px;
            border-top: 1px solid rgba(210,65,115,.15);
            color: #9b4b68;
            text-align: right;
            font-family: Georgia,"Times New Roman",serif;
            font-style: italic;
            line-height: 1.7;
        }

        .signature span {
            color: #d12c66;
            font-weight: 700;
        }

        @media (max-width:700px) {
            .letter-scene {
                width: 100%;
                height: 82vh;
            }

            .closed-letter {
                width: min(410px,88vw);
            }

            .envelope-flap {
                border-left-width: 205px;
                border-right-width: 205px;
                border-top-width: 155px;
            }

            .wax-heart {
                width: 58px;
                height: 58px;
                font-size: 26px;
            }

            .paper {
                max-height: 82vh;
                padding: 42px 25px 35px;
            }

            .letter-content p {
                font-size: 15px;
                line-height: 1.7;
            }
        }

.floating-heart {
    position: fixed;
    bottom: -30px;

    font-size: 18px;

    pointer-events: none;

    animation: floatHeart linear forwards;

    opacity: .7;
}

@keyframes floatHeart {

    0% {
        transform:
            translateY(0)
            rotate(0deg)
            scale(.8);

        opacity: 0;
    }

    15% {
        opacity: .7;
    }

    100% {
        transform:
            translateY(-110vh)
            rotate(360deg)
            scale(1.4);

        opacity: 0;
    }
}

/* =========================
   RUNG KHI SAI MK
========================= */

.shake {
    animation: shake .4s;
}

@keyframes shake {
    0%,100% {
        transform: translateX(0);
    }

    25% {
        transform: translateX(-8px);
    }

    50% {
        transform: translateX(8px);
    }

    75% {
        transform: translateX(-5px);
    }
}

/* =========================
   MOBILE
========================= */

@media (max-width: 700px) {

    body {
        overflow: auto;
    }

    #loginScreen {
        padding: 15px;
    }

    .login-box {
        grid-template-columns: 1fr;
        min-height: auto;
        border-radius: 24px;
    }

    .photo-side {
        min-height: 300px;
        height: 300px;
    }

    .photo-text {
        left: 25px;
        bottom: 25px;
    }

    .photo-text h2 {
        font-size: 27px;
    }

    .password-side {
        padding: 35px 20px;
    }

    .password-side h1 {
        font-size: 27px;
    }

    .keypad {
        width: 300px;
    }

    .key {
        height: 53px;
    }

    .love-content h1 {
        font-size: 38px;
    }
}

        /* =========================================
           NÚT ĐI ĐẾN KỶ NIỆM
        ========================================= */

        .memory-button {
            display: block;
            margin: 28px auto 0;
            padding: 13px 24px;

            border: 0;
            border-radius: 999px;

            background: linear-gradient(135deg, #e83e67, #c91f4d);
            color: #fff;

            font-family: inherit;
            font-size: 14px;
            font-weight: 700;

            cursor: pointer;

            box-shadow:
                0 10px 25px rgba(201, 31, 77, .22);

            transition: .25s ease;
        }

        .memory-button:hover {
            transform: translateY(-3px) scale(1.02);
            box-shadow:
                0 14px 30px rgba(201, 31, 77, .28);
        }

        /* =========================================
           KHÔNG GIAN 3D KIỂU DẢI NGÂN HÀ - 10 ẢNH
        ========================================= */

        #memoriesPage {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 20;
            overflow: hidden;
            touch-action: none;
            background:
                radial-gradient(circle at 50% 50%,
                    rgba(255,255,255,.98) 0 3%,
                    rgba(255,220,231,.75) 10%,
                    transparent 32%),
                radial-gradient(circle at 15% 20%,
                    rgba(255,255,255,.72),
                    transparent 26%),
                radial-gradient(circle at 85% 78%,
                    rgba(255,190,210,.45),
                    transparent 30%),
                linear-gradient(135deg,#fff7f9 0%,#ffe8ef 45%,#f9d5e1 100%);
            color: #702c45;
        }

        /* Các hạt nhỏ tạo cảm giác không gian */
        #memoriesPage::before,
        #memoriesPage::after {
            content: "";
            position: absolute;
            inset: -20%;
            pointer-events: none;
            opacity: .55;
            background-image:
                radial-gradient(circle, rgba(255,255,255,.95) 0 2px, transparent 3px),
                radial-gradient(circle, rgba(207,45,86,.25) 0 1px, transparent 2px);
            background-size: 105px 95px, 73px 81px;
            animation: galaxyDust 28s linear infinite;
        }

        #memoriesPage::after {
            opacity: .32;
            transform: scale(1.3);
            animation-duration: 42s;
            animation-direction: reverse;
        }

        @keyframes galaxyDust {
            from { transform: translate3d(0,0,0) rotate(0deg); }
            to   { transform: translate3d(-80px,45px,0) rotate(12deg); }
        }

        .memories-header {
            position: absolute;
            top: 5vh;
            left: 20px;
            right: 20px;
            text-align: center;
            z-index: 30;
            pointer-events: none;
        }

        .memories-kicker {
            color: #cf3b62;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 4px;
        }

        .memories-header h2 {
            margin: 7px 0 5px;
            color: #c72f58;
            font-family: Georgia,"Times New Roman",serif;
            font-size: clamp(28px,5vw,46px);
            font-style: italic;
            text-shadow: 0 3px 15px rgba(190,35,80,.12);
        }

        .memories-header p {
            margin: 0;
            color: #a75a70;
            font-size: 14px;
        }

        /* =========================================
           KHÔNG GIAN 3D - DẢI NGÂN HÀ TÁCH ẢNH
        ========================================= */

        #memoriesPage {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 20;
            overflow: hidden;
            touch-action: none;
            background:
                radial-gradient(circle at 50% 48%, rgba(255,255,255,.98) 0 5%, rgba(255,222,232,.82) 19%, transparent 43%),
                radial-gradient(circle at 15% 18%, rgba(255,255,255,.9), transparent 30%),
                radial-gradient(circle at 85% 78%, rgba(255,187,211,.5), transparent 32%),
                linear-gradient(135deg,#fff9fb 0%,#ffeaf1 48%,#fbd9e5 100%);
            color: #8f3d59;
        }

        #memoriesPage::before {
            content: "";
            position: absolute;
            inset: -20%;
            pointer-events: none;
            opacity: .58;
            background-image:
                radial-gradient(circle, rgba(255,255,255,.98) 0 1.7px, transparent 2.5px),
                radial-gradient(circle, rgba(205,49,91,.23) 0 1px, transparent 2px);
            background-size: 88px 82px, 61px 73px;
            animation: starDrift 30s linear infinite;
        }

        @keyframes starDrift {
            from { transform: translate3d(0,0,0); }
            to { transform: translate3d(-80px,45px,0); }
        }

        .memories-header {
            position: absolute;
            top: 5vh;
            left: 20px;
            right: 20px;
            text-align: center;
            z-index: 100;
            pointer-events: none;
        }

        .memories-kicker {
            color: #cf3b62;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 4px;
        }

        .memories-header h2 {
            margin: 7px 0 5px;
            color: #c72f58;
            font-family: Georgia,"Times New Roman",serif;
            font-size: clamp(28px,5vw,46px);
            font-style: italic;
            text-shadow: 0 3px 15px rgba(190,35,80,.12);
        }

        .memories-header p {
            margin: 0;
            color: #a75a70;
            font-size: 14px;
        }
        /* Vùng thao tác 3D: kéo trực tiếp bằng chuột / cảm ứng */
        .photo-world {
            position: absolute;
            inset: 0;
            perspective: 1450px;
            perspective-origin: 50% 50%;
            overflow: hidden;
            cursor: grab;
            touch-action: none;
            user-select: none;
            -webkit-user-select: none;
            -webkit-touch-callout: none;
            z-index: 10;
        }

        .photo-world.dragging {
            cursor: grabbing;
        }

        .photo-carousel {
            position: absolute;
            left: 50%;
            top: 54%;
