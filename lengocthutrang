<script>

/* =========================
   MẬT KHẨU
========================= */

const CORRECT_PASSWORD = "1401";

let currentPassword = "";

const passwordDisplay =
    document.getElementById("passwordDisplay");

const error =
    document.getElementById("error");


/* =========================
   BẤM SỐ
========================= */

function pressNumber(number) {

    if (
        currentPassword.length >=
        CORRECT_PASSWORD.length
    ) {
        return;
    }

    currentPassword += number;

    updateDisplay();

    error.textContent = "";

    if (
        currentPassword.length ===
        CORRECT_PASSWORD.length
    ) {
        setTimeout(checkPassword, 250);
    }
}


/* =========================
   HIỂN THỊ DẤU CHẤM
========================= */

function updateDisplay() {

    if (currentPassword.length === 0) {

        passwordDisplay.innerHTML =
            `<span style="
                color:#765766;
                letter-spacing:5px;
            ">• • • •</span>`;

        passwordDisplay.classList.remove("active");

        return;
    }

    let dots = "";

    for (
        let i = 0;
        i < currentPassword.length;
        i++
    ) {
        dots += `<span class="dot"></span>`;
    }

    passwordDisplay.innerHTML = dots;

    passwordDisplay.classList.add("active");
}


/* =========================
   KIỂM TRA MẬT KHẨU
========================= */

function checkPassword() {

    if (
        currentPassword ===
        CORRECT_PASSWORD
    ) {

        error.textContent = "";

        document.getElementById(
            "loginScreen"
        ).style.display = "none";

        document.getElementById(
            "lovePage"
        ).style.display = "flex";

        startHearts();

        return;
    }

    error.textContent =
        "Mật khẩu chưa đúng rồi ❤️";

    passwordDisplay.classList.remove("shake");

    void passwordDisplay.offsetWidth;

    passwordDisplay.classList.add("shake");

    setTimeout(function () {

        currentPassword = "";

        updateDisplay();

    }, 500);
}


/* =========================
   XÓA SỐ CUỐI
========================= */

function deleteNumber() {

    currentPassword =
        currentPassword.slice(0, -1);

    updateDisplay();

    error.textContent = "";
}


/* =========================
   XÓA TẤT CẢ
========================= */

function clearPassword() {

    currentPassword = "";

    updateDisplay();

    error.textContent = "";
}


/* =========================
   TIM BAY
========================= */

function createHeart() {

    const heart =
        document.createElement("div");

    heart.className =
        "floating-heart";

    const hearts = [
        "❤️",
        "💗",
        "💕",
        "💖",
        "💘",
        "💞"
