                const dx = (Math.random() > .5 ? 1 : -1) *
                    (10 + Math.random() * 35);
                const dy = (Math.random() > .5 ? 1 : -1) *
                    (10 + Math.random() * 40);

                heart.style.setProperty("--x", pos[0]);
                heart.style.setProperty("--y", pos[1]);
                heart.style.setProperty(
                    "--dx",
                    dx.toFixed(0) + "px"
                );
                heart.style.setProperty(
                    "--dy",
                    dy.toFixed(0) + "px"
                );
                heart.style.setProperty(
                    "--size",
                    (parseFloat(type.size) * sizeMultiplier).toFixed(1) + "px"
                );
                heart.style.setProperty("--opacity", type.opacity);
                heart.style.setProperty(
                    "--duration",
                    (2 + Math.random() * 3).toFixed(1) + "s"
                );
                heart.style.setProperty(
                    "--twinkle",
                    (2.4 + Math.random() * 3.2).toFixed(1) + "s"
                );
                heart.style.animationDelay =
                    (-Math.random() * 8).toFixed(2) + "s";

                world.appendChild(heart);
            });
        }

        function setupMemoryCards() {
            const cards = document.querySelectorAll(".memory-card");
            if (!cards.length) return;

            const mobile = window.innerWidth < 650;

            /*
             * Đây là DẢI NGÂN HÀ:
             * mỗi ảnh có một vị trí X/Y/Z RIÊNG.
             * Không còn nằm sát nhau thành một vòng tròn.
             */
            const radiusX = mobile ? 300 : 540;
            const radiusZ = mobile ? 330 : 590;
            const verticalStep = mobile ? 78 : 112;

            cards.forEach(function(card, index) {
                const t = index / cards.length;
                const angle = t * Math.PI * 2.35;

                const x = Math.cos(angle) * radiusX;
                const z = Math.sin(angle) * radiusZ;

                /*
                 * Trải thành một dải xoắn:
                 * ảnh 1 ở dưới/trước,
                 * ảnh 5-6 ở trung tâm,
                 * ảnh 10 ở trên/sau.
                 */
                const y =
                    (index - (cards.length - 1) / 2) * verticalStep +
                    Math.sin(angle * 1.7) * (mobile ? 55 : 75);

                card.dataset.x = x;
                card.dataset.y = y;
                card.dataset.z = z;
                card.dataset.angle = angle;
            });

            renderGalaxy();
        }

        function renderGalaxy() {
            const cards = document.querySelectorAll(".memory-card");

            const cy = Math.cos(targetYaw);
            const sy = Math.sin(targetYaw);

            const cp = Math.cos(targetPitch);
            const sp = Math.sin(targetPitch);

            cards.forEach(function(card) {
                const x = Number(card.dataset.x);
                const y = Number(card.dataset.y);
                const z = Number(card.dataset.z);

                /* Xoay quanh trục Y */
                let rx = x * cy - z * sy;
                let rz = x * sy + z * cy;

                /* Xoay lên/xuống quanh trục X */
                let ry = y * cp - rz * sp;
                rz = y * sp + rz * cp;

                /*
                 * Ảnh càng gần người xem càng lớn,
                 * ảnh càng xa càng nhỏ -> cảm giác 3D rõ hơn.
                 */
                const scale =
                    Math.max(.48, Math.min(1.35, 1 + rz / 1050));

                const depthOpacity =
                    Math.max(.48, Math.min(1, .62 + scale * .30));

                /*
                 * Không xoay mặt ảnh quá mạnh.
                 * Chỉ nghiêng nhẹ theo vị trí để vẫn nhìn rõ từng ảnh.
                 */
                const faceTurn =
                    Math.max(-24, Math.min(24, rx / 26));

                const tilt =
                    Math.max(-13, Math.min(13, ry / 38));

                card.style.transform =
                    "translate3d(" +
                    (rx - 92) + "px," +
                    (ry - 124) + "px," +
                    rz + "px) " +
                    "rotateY(" + faceTurn + "deg) " +
                    "rotateX(" + tilt + "deg) " +
                    "scale(" + scale + ")";

                card.style.opacity = depthOpacity;
                card.style.zIndex = String(2000 + Math.round(rz));
            });
        }

        function animateGalaxy() {
            if (!memoryDragging) {
                targetYaw += memoryVelocityX;
                targetPitch += memoryVelocityY;

                memoryVelocityX *= .94;
                memoryVelocityY *= .94;
            }

            targetPitch =
                Math.max(-0.72, Math.min(0.72, targetPitch));

            memoryYaw += (targetYaw - memoryYaw) * .18;
            memoryPitch += (targetPitch - memoryPitch) * .18;

            /* Render bằng giá trị thực tế để chuyển động mượt */
            const oldYaw = targetYaw;
            const oldPitch = targetPitch;

            targetYaw = memoryYaw;
            targetPitch = memoryPitch;
            renderGalaxy();
            targetYaw = oldYaw;
            targetPitch = oldPitch;

            memoryAnimation =
                requestAnimationFrame(animateGalaxy);
        }

        function rotateMemories(direction) {
            targetYaw += direction * (Math.PI / 4);
            memoryVelocityX = direction * .008;
        }

        /*
         * Dùng CAPTURE PHASE + preventDefault:
         * kéo ở bất kỳ đâu trên sân khấu, kể cả đè lên ảnh,
         * đều được bắt bởi photoWorld.
         */
        function memoryPointerDown(event) {
            if (event.pointerType === "mouse" && event.button !== 0) {
                return;
            }

            event.preventDefault();

            memoryDragging = true;
            memoryLastX = event.clientX;
            memoryLastY = event.clientY;
            memoryVelocityX = 0;
            memoryVelocityY = 0;

            const world = document.getElementById("photoWorld");

            if (world) {
                world.classList.add("dragging");

                try {
                    world.setPointerCapture(event.pointerId);
                } catch (e) {}
            }
        }

        function memoryPointerMove(event) {
            if (!memoryDragging) return;

            event.preventDefault();

            const dx = event.clientX - memoryLastX;
            const dy = event.clientY - memoryLastY;

            memoryLastX = event.clientX;
            memoryLastY = event.clientY;

            /*
             * Kéo ngang: bay vòng quanh dải ảnh.
             * Kéo dọc: bay lên/xuống.
             */
            targetYaw += dx * 0.008;
            targetPitch += dy * 0.004;

            memoryVelocityX = dx * 0.0007;
            memoryVelocityY = dy * 0.00035;

            targetPitch =
                Math.max(-0.72, Math.min(0.72, targetPitch));
        }

        function memoryPointerUp(event) {
            if (!memoryDragging) return;

            event.preventDefault();
            memoryDragging = false;

            const world = document.getElementById("photoWorld");

            if (world) {
                world.classList.remove("dragging");

                try {
                    world.releasePointerCapture(event.pointerId);
                } catch (e) {}
            }
        }

        function initMemoryControls() {
            const world = document.getElementById("photoWorld");
            if (!world) return;

            /*
             * Không passive để preventDefault hoạt động trên mobile.
             */
            world.addEventListener(
                "pointerdown",
                memoryPointerDown,
                { passive: false, capture: true }
            );

            world.addEventListener(
                "pointermove",
                memoryPointerMove,
                { passive: false, capture: true }
            );

            world.addEventListener(
                "pointerup",
                memoryPointerUp,
                { passive: false, capture: true }
            );

            world.addEventListener(
                "pointercancel",
                memoryPointerUp,
                { passive: false, capture: true }
            );

            world.addEventListener(
                "pointerleave",
                function(event) {
                    if (memoryDragging && event.pointerType === "mouse") {
                        memoryPointerUp(event);
                    }
                },
                { passive: false, capture: true }
            );

            /* Lăn chuột cũng xoay dải ảnh */
            world.addEventListener(
                "wheel",
                function(event) {
                    event.preventDefault();
                    targetYaw += event.deltaY * 0.0018;
                    targetPitch += event.deltaX * 0.001;
                },
                { passive: false }
            );

            /* Fallback cảm ứng cho trình duyệt không bắt Pointer Events ổn định */
            world.addEventListener("touchstart", function (event) {
                if (!event.touches || !event.touches[0]) return;
                const t = event.touches[0];
                memoryDragging = true;
                memoryLastX = t.clientX;
                memoryLastY = t.clientY;
                memoryVelocityX = 0;
                memoryVelocityY = 0;
                event.preventDefault();
            }, { passive: false });

            world.addEventListener("touchmove", function (event) {
                if (!memoryDragging || !event.touches || !event.touches[0]) return;
                const t = event.touches[0];
                const dx = t.clientX - memoryLastX;
                const dy = t.clientY - memoryLastY;
                memoryLastX = t.clientX;
                memoryLastY = t.clientY;
                targetYaw += dx * 0.008;
                targetPitch += dy * 0.004;
                targetPitch = Math.max(-0.72, Math.min(0.72, targetPitch));
                memoryVelocityX = dx * 0.0007;
                memoryVelocityY = dy * 0.00035;
                event.preventDefault();
            }, { passive: false });

            world.addEventListener("touchend", function (event) {
                memoryDragging = false;
                event.preventDefault();
            }, { passive: false });

            window.addEventListener(
                "resize",
                setupMemoryCards
            );

            setupMemoryCards();
            renderGalaxy();

            if (!memoryAnimation) {
                animateGalaxy();
            }
        }

        /* Script nằm trước HTML #photoWorld nên phải chờ DOM tạo xong. */
        document.addEventListener("DOMContentLoaded", function () {
            initMemoryControls();
        });

</script>


