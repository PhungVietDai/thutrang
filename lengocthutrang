    heart.style.left =
        Math.random() * 100 + "vw";

    heart.style.animationDuration =
        (5 + Math.random() * 5) + "s";

    heart.style.animationDelay =
        (Math.random() * 0.8) + "s";

    heart.style.fontSize =
        (14 + Math.random() * 18) + "px";

    document.body.appendChild(heart);

    setTimeout(function () {
        heart.remove();
